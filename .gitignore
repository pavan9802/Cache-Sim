# Maven build output
target/

# JMH benchmark results (large JSON files — committed selectively)
results/*.json
results/*/
results/profiles/
results/flamegraphs/

# IDE files
.idea/
*.iml
.vscode/
*.classpath
*.project
.settings/

# OS metadata
.DS_Store
Thumbs.db

# GC logs
*.log
gc-*.log

# JVM profiling
*.jfr
*.hprof

# Claude Code local settings (user-specific permissions — not shared)
.claude/settings.local.json

# Keep the results directory itself
!results/.gitkeep

# jcstress output — binary result blobs and HTML reports
jcstress-results/
jcstress-results-*.bin.gz
results/*.html
results/*.html.gz

# Maven Shade plugin leaves a dependency-reduced-pom.xml next to the module pom
dependency-reduced-pom.xml

# META-INF extracted from jars into the repo root (e.g. unzip -p ... META-INF/TestList)
META-INF/

